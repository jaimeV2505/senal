# Genera uno largo y aleatorio (ej: openssl rand -base64 48)
AUTH_SECRET=

# La clave que le das a la otra persona para llegar a la pantalla de bienvenida
ENTRY_KEY=

# Claves personales de cada uno (para entrar al chat después del "sí")
KEY_A=
KEY_B=

# Cuánto tiempo viven los mensajes antes de autodestruirse (en segundos)
# 86400 = 24 horas
MESSAGE_TTL_SECONDS=86400

# Estas dos las genera Vercel automáticamente al conectar el Marketplace KV
# (Storage -> Create Database -> KV). No las escribas a mano.
KV_REST_API_URL=
KV_REST_API_TOKEN=
